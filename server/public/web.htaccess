# Deployed as .htaccess beside the web client's index.html. The bundle files
# carry content hashes and can cache forever; index.html must always
# revalidate, or a phone shows last week's app against this week's data.
<Files "index.html">
  Header set Cache-Control "no-cache"
</Files>
<FilesMatch "\.(js|png)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<Files "favicon.ico">
  Header set Cache-Control "public, max-age=3600"
</Files>
