{
  "name": "calmind",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/app",
    "desktop"
  ],
  "scripts": {
    "test": "npm run test:core && npm run test:server",
    "test:core": "npm -w @calmind/core run test -- --run",
    "test:server": "php server/tools/test.php",
    "web": "npm -w app run web",
    "export:web": "npm -w app exec expo export -- -p web && node tools/patch-web-html.mjs",
    "test:e2e": "npm run export:web && playwright test",
    "test:e2e:fast": "playwright test",
    "test:webkit": "playwright test -c playwright.webkit.config.ts",
    "test:watch": "sh tools/check-watch-format.sh && sh tools/check-watch-feed.sh",
    "test:widget": "sh tools/check-widget-feed.sh && sh tools/check-appgroup.sh",
    "test:counts": "sh tools/check-suite-counts.sh",
    "test:simfresh": "sh tools/check-sim-fresh.sh",
    "test:deploy": "sh tools/check-deploy-guards.sh",
    "test:desktop": "sh desktop/check-assets.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
